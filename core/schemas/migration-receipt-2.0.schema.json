{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_snapshot",
    "closed_source_snapshot",
    "origin",
    "target",
    "mapping",
    "elements",
    "pending",
    "runtime",
    "authorization",
    "verification",
    "migration_state",
    "conservation",
    "conservation_counts",
    "approval",
    "audit",
    "cutover"
  ],
  "properties": {
    "source_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "closed_source_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "const": "1.5"
    },
    "target": {
      "const": "2.0"
    },
    "mapping": {
      "type": "object"
    },
    "elements": {
      "type": "object"
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtime": {
      "type": "object"
    },
    "authorization": {
      "const": "reconciliation-required"
    },
    "verification": {
      "const": "not-run"
    },
    "migration_state": {
      "const": "migration-complete"
    },
    "conservation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "sha256",
          "disposition"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "disposition": {
            "enum": [
              "transformed",
              "archived",
              "preserved-out-of-scope",
              "blocked"
            ]
          },
          "archive": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "conservation_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "mode",
        "status"
      ],
      "properties": {
        "mode": {
          "const": "exact-preview-hash"
        },
        "status": {
          "const": "required-before-apply"
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": [
        "all_sources_accounted",
        "source_count",
        "closed_source_snapshot",
        "conservation_fingerprint",
        "prospective_contract",
        "external_observers"
      ],
      "properties": {
        "all_sources_accounted": {
          "const": true
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "closed_source_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conservation_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prospective_contract": {
          "const": "passed"
        },
        "external_observers": {
          "const": "not-run"
        }
      },
      "additionalProperties": true
    },
    "cutover": {
      "type": "object",
      "required": [
        "active_schema",
        "active_method",
        "legacy_writers",
        "continuation"
      ],
      "properties": {
        "active_schema": {
          "const": "2.0"
        },
        "active_method": {
          "enum": ["2.0.0", "2.1.0"]
        },
        "legacy_writers": {
          "const": "blocked"
        },
        "continuation": {
          "const": "selective-per-task"
        }
      },
      "additionalProperties": true
    }
  }
}
