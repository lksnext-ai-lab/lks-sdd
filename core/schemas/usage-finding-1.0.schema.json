{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks-sdd.invalid/usage-finding-1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lks-sdd-usage-finding/1"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rule": {
      "enum": [
        "UF-01",
        "UF-02",
        "UF-03",
        "UF-04",
        "UF-05",
        "UF-06",
        "UF-07"
      ]
    },
    "rule_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "confirmed-problem",
        "improvement-candidate",
        "needs-evidence",
        "dismissed-with-reason",
        "resolved-with-evidence"
      ]
    },
    "target": {
      "enum": [
        "plugin",
        "consumer-documentation",
        "host",
        "shared",
        "unknown"
      ]
    },
    "fact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "priority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "priority_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "success_criterion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    },
    "history": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "format",
    "finding_id",
    "signature",
    "rule",
    "rule_version",
    "state",
    "target",
    "fact",
    "hypothesis",
    "impact",
    "priority",
    "priority_reason",
    "next_action",
    "success_criterion",
    "component",
    "occurrences",
    "materials",
    "history"
  ]
}
