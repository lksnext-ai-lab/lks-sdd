      "allowed": ["draft", "proposed", "confirmed", "open", "blocked", "accepted", "mitigated", "resolved", "superseded", "retired"],
      "active": ["confirmed", "open", "blocked", "accepted", "mitigated"],
      "pending": ["draft", "proposed"],
      "inactive": ["resolved", "superseded", "retired"],
      "legacy_classes": {"assumption": "pending"}
