{
  "schema_version": "1.0",
  "profile_id": "WEB-NEXTJS-SSR-NODE",
  "profile_version": "1.0.0",
  "prepare": {"strategy": "copy", "sources": [{"from": "profiles/WEB-NEXTJS-SSR-NODE/scaffold", "to": "."}]},
  "verify": {
    "checks": [
      {"id": "GATE-SCAFFOLD-INTEGRITY", "name": "scaffold-integrity", "phase": "G2", "kind": "command", "cwd": ".", "command": ["python", "-c", "from pathlib import Path; assert Path('next.config.ts').is_file(); assert Path('app/page.tsx').is_file()"], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-FRONTEND-LOCK", "name": "frontend-lock", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "ci", "--ignore-scripts"], "required": true, "requires_containers": false, "timeout_seconds": 600},
      {"id": "GATE-FRONTEND-LINT", "name": "frontend-lint", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "lint"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-FRONTEND-TYPECHECK", "name": "frontend-typecheck", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "typecheck"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-FRONTEND-TEST", "name": "frontend-tests", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "test"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-SSR-BUILD", "name": "ssr-build", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "build"], "required": true, "requires_containers": false, "timeout_seconds": 600},
      {"id": "GATE-SSR-RUNTIME", "name": "ssr-runtime-contract", "phase": "G3", "kind": "command", "cwd": ".", "command": ["python", "-c", "from pathlib import Path; assert Path('.next/server/app/index.html').is_file() or Path('.next/server/app/page.js').is_file(); assert Path('.next/BUILD_ID').is_file()"], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-SSR-HYDRATION", "name": "ssr-hydration", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "hydration"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-BROWSER-SMOKE", "name": "browser-smoke", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "smoke"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-BROWSER-ACCESSIBILITY", "name": "browser-accessibility", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "accessibility"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-DELIVERY-EVIDENCE", "name": "delivery-evidence", "phase": "G4", "kind": "delivery-evidence", "cwd": ".", "command": [], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-COMPOSE-NEXTJS-SSR", "name": "profile-composition", "phase": "G3", "kind": "command", "cwd": ".", "command": ["python", "-c", "import json; p=json.load(open('package.json', encoding='utf-8')); assert 'next' in p['dependencies']; assert json.load(open('.next/routes-manifest.json', encoding='utf-8'))"], "required": true, "requires_containers": false, "timeout_seconds": 30}
    ]
  }
}
