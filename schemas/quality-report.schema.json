{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/quality-report-1.2.json",
  "title": "LKS-SDD quality harness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "plugin_version",
    "evaluated_on",
    "channel",
    "source",
    "inputs",
    "checks",
    "execution",
    "performance",
    "channels",
    "metrics",
    "critical_failures",
    "comparison",
    "gate"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "suite": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "evaluated_on": {"type": "string", "format": "date"},
    "channel": {"enum": ["candidate", "stable"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree_state"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_state": {"enum": ["clean", "dirty"]}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_sha256",
        "corpus_sha256",
        "definition_corpus_sha256",
        "fixture_manifest_sha256",
        "observations_sha256",
        "pilot_summary_sha256",
        "baseline_sha256",
        "performance_policy_sha256"
      ],
      "properties": {
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "definition_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observations_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "pilot_summary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "performance_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "critical", "summary", "duration_seconds", "timeout_seconds", "termination", "process_cleanup", "reproduce"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "critical": {"type": "boolean"},
          "summary": {"type": "string"},
          "duration_seconds": {"type": "number"},
          "timeout_seconds": {"type": ["integer", "null"]},
          "termination": {"type": "string", "minLength": 1},
          "process_cleanup": {"type": "string", "minLength": 1},
          "reproduce": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_fingerprint", "profile_mode", "duration_seconds", "rerun_reason"],
      "properties": {
        "runner_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture", "python", "implementation", "runner_class"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "python": {"type": "string", "minLength": 1},
            "implementation": {"type": "string", "minLength": 1},
            "runner_class": {"type": "string", "minLength": 1}
          }
        },
        "profile_mode": {"enum": ["not-run", "reuse", "execute"]},
        "duration_seconds": {"type": "number"},
        "rerun_reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baseline_version", "baseline_comparable", "comparison_reason", "comparisons", "regressions"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "baseline_version": {"type": "string", "minLength": 1},
        "baseline_comparable": {"type": "boolean"},
        "comparison_reason": {"type": "string", "minLength": 1},
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite", "actual_seconds", "budget_seconds", "baseline_seconds", "allowed_seconds", "regressed"],
            "properties": {
              "suite": {"type": "string", "minLength": 1},
              "actual_seconds": {"type": "number"},
              "budget_seconds": {"type": ["number", "null"]},
              "baseline_seconds": {"type": ["number", "null"]},
              "allowed_seconds": {"type": ["number", "null"]},
              "regressed": {"type": "boolean"}
            }
          }
        },
        "regressions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "channels": {"type": "object", "minProperties": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "critical_failures": {"type": "array", "items": {"type": "string"}},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_version",
        "baseline_commit",
        "status",
        "comparisons",
        "regressions",
        "not_compared",
        "current_only"
      ],
      "properties": {
        "baseline_version": {"type": "string", "minLength": 1},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"enum": ["passed", "failed"]},
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "direction", "baseline", "current", "regressed"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "direction": {"enum": ["higher", "lower", "neutral"]},
              "baseline": {"type": "number"},
              "current": {"type": "number"},
              "regressed": {"type": "boolean"}
            }
          }
        },
        "regressions": {"type": "array", "items": {"type": "string"}},
        "not_compared": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "current_only": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "eligible", "blockers", "missing_evidence"],
      "properties": {
        "status": {"enum": ["passed", "failed", "incomplete"]},
        "eligible": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
