{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.example/schemas/verification-evidence-1.3.schema.json",
  "title": "LKS-SDD verification evidence 1.3",
  "type": "object",
  "required": [
    "schema_version", "evidence_id", "increment", "task_ids",
    "bindings", "classification", "gate_applicability", "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.3"},
    "evidence_id": {"type": "string", "pattern": "^EVID-[0-9]{3}$"},
    "execution_id": {"type": "string", "pattern": "^EXEC-[0-9]{3}$"},
    "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
    "task_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}
    },
    "bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^BIND-[0-9]{3}$"}
    },
    "binding_locks": {"type": "array", "items": {"type": "object"}},
    "build_identity_material": {"type": "object"},
    "build_id": {"type": "string", "pattern": "^build-sha256:[a-f0-9]{64}$"},
    "gate_applicability": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "scope", "task_ids", "reason"],
        "properties": {
          "gate_id": {"enum": ["GATE-VISUAL-BROWSER-REVIEW", "GATE-BROWSER-FULLSTACK-E2E", "GATE-HTTP-CONTRACT-INTEGRATION", "GATE-DATA-INTEGRATION", "GATE-DATA-MIGRATION"]},
          "status": {"enum": ["applicable", "not-applicable"]},
          "scope": {"enum": ["task-slice", "release", "interface"]},
          "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "classification": {"enum": ["verified", "verified-with-reservations", "not-verified"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence_scopes", "interface_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "gate_id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]{3,80}$"},
          "status": {"enum": ["passed", "failed", "blocked", "not-run"]},
          "evidence_scopes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["component", "contract", "composition", "user-flow", "persistence", "visual"]}
          },
          "interface_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^INT-[0-9]{3}$"}
          },
          "mocks": {"type": "array", "items": {"type": "object"}},
          "observations": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
