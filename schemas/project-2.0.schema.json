{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "method_version",
    "project_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "method_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "plugin_version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "migration": {
      "type": "object",
      "properties": {
        "origin_schema": {
          "const": "1.5"
        },
        "source_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "closed_source_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "migration-complete",
            "continuation-ready",
            "blocked",
            "mixed-contract",
            "rolled-back"
          ]
        },
        "legacy_writers": {
          "const": "blocked"
        },
        "receipt_path": {
          "type": "string",
          "pattern": "^docs/lks-sdd/00-control/migrations/[a-f0-9]{16}\\.json$"
        },
        "conservation_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/lks-sdd/.*\\.md$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs/lks-sdd/03-solution/technology-declaration.md"
              }
            }
          }
        }
      }
    }
  ]
}
