  "acceptance_criteria_add": {
    "AC-45": {
      "owner": "V4-19",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "El censo del reporte no falla por rutas internas; 20.000 elegibles aceptan y 20.001 rechazan. Inventarios antes válidos conservan contenido y semántica."
    },
    "AC-46": {
      "owner": "V4-19",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Límites brutos/stdout/stderr/tiempo durante captura y memoria acotada; sin inventario parcial válido, lectura de secretos ni escape por prefijos, rutas, enlaces o junctions."
    },
    "AC-47": {
      "owner": "V4-19",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Workflow, preparación, scope y aplicación comparten la corrección; cambios de código, política/base o sujetos entre preparación y aplicación se rechazan."
    },
    "AC-48": {
      "owner": "V4-20",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Un recorrido completo con Git real e historia acumulada cancela, continúa con sucesora y cierra nativamente con almacenamiento anterior; runtime corregido, trazabilidad conservada y sin journal pendiente."
    },
    "AC-49": {
      "owner": "V4-20",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Reutilizar solo autoridad/evidencia vigentes; negativa e interrupción focales conservan o recuperan estado válido. Procedimiento del caso real distingue solución disponible y recuperación aún no ejecutada."
    },
    "AC-50": {
      "owner": "V4-21",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Lector dual y rutas lógicas conservan bytes, sujetos, enlaces y Markdown; staging, packets y diarios 2.0/2.1 funcionan; capacidades comprobadas antes de escritura. ZIP inseguro/corrupto o representación contradictoria se rechaza."
    },
    "AC-51": {
      "owner": "V4-21",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Sobre el B congelado, altas persistentes internas ≤81 frente a 407 (≥80 % menos); incluir índices/recibos y no compensar eliminando entradas iniciales. Escritor publica agrupado, sin objetos sueltos intermedios por fragmento. Bytes nuevos persistidos ≤1,10× la referencia completa."
    },
    "AC-52": {
      "owner": "V4-21",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Consultas sin escritura; reintento idempotente completado sin copias nuevas. CPU mediana del componente ≤1,10× referencia; pico ≤512 MiB y ≤1,10× referencia, con integridad/localización incluidas. Informar dispersión, pared y temporales, sin atribuir mejora global de S8."
    },
    "AC-53": {
      "owner": "V4-22",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "En histórico de composición congelada, ≥50 % menos archivos internos activos, incluidos paquetes/recibos, manteniendo runtime, Markdown y objetos lógicos. Todas las referencias se resuelven y objetos originales se restauran byte a byte. Informar archivos/bytes de backup y Git por separado."
    },
    "AC-54": {
      "owner": "V4-22",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Fallos antes/después de publicar, durante retirada y al completar recibo son recuperables; sin doble propietario, pérdida ni corrupción oculta. El diario de negocio se recupera sin catálogo global; mantenimiento conserva recuperación propia y no autoriza estados funcionales."
    },
    "AC-55": {
      "owner": "V4-22",
      "related_owners": [],
      "status": "proposed-not-run",
      "criterion": "Preview fija originales, destinos, respaldo, espacio y protegidos; retirar solo duplicados físicos previamente verificados y autorizados. Conservar contenido de referencia desconocida; cero GC/limpieza por consulta o edad."
    },
    "AC-56": {
      "owner": "V4-16",
      "related_owners": [
        "V4-14",
        "V4-15",
        "V4-22"
      ],
      "status": "proposed-not-run",
      "criterion": "V4-14/15 aportan compatibilidad y garantías afectadas; paquetes finales declaran capacidades y pasan controles exigibles sobre su huella exacta. Rollback tras datos nuevos exige restauración/materialización compatible, no solo cambiar el pin. Sin instalación/publicación reales."
    }
  },
