{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional project technology variants 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy", "variants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allow_task_closure", "allowed_stages", "approver_roles", "max_age_days", "cache_max_age_hours"],
      "properties": {
        "mode": {"enum": ["strict", "approved-project-variants"]},
        "allow_task_closure": {"type": "boolean"},
        "allowed_stages": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["development", "integration", "preproduction", "release", "production"]}},
        "approver_roles": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "max_age_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "cache_max_age_hours": {"type": "integer", "minimum": 0, "maximum": 168}
      }
    },
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
  },
  "$defs": {
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "profile_id", "increment", "release", "task_ids", "environment", "technology_roots", "inputs", "composition", "gates"],
      "properties": {
        "id": {"type": "string", "pattern": "^VAR-[0-9]{3}$"},
        "profile_id": {"type": "string", "minLength": 1},
        "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
        "release": {"type": "string", "pattern": "^REL-[0-9]{3}$"},
        "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
        "environment": {"type": "string", "pattern": "^(ENV-[0-9]{3}|not-applicable)$"},
        "technology_roots": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1},
        "inputs": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1},
        "composition": {"type": "object", "minProperties": 1},
        "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "stage", "scopes", "interfaces", "deterministic", "timeout_seconds", "image"],
      "properties": {
        "id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]{3,80}$"},
        "source": {"enum": ["packaged", "approved-consumer", "experimental"]},
        "stage": {"enum": ["development", "integration", "release"]},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["component", "contract", "composition", "user-flow", "persistence", "visual"]}},
        "interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^INT-[0-9]{3}$"}},
        "deterministic": {"type": "boolean"},
        "inputs": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "image": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:+-]*@sha256:[a-f0-9]{64}$"},
        "observer": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "command"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "inputs": {"$ref": "#/$defs/paths"},
            "command": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1}}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "approved-consumer"}}}, "then": {"required": ["observer"]}},
        {"if": {"properties": {"source": {"const": "packaged"}}}, "then": {"not": {"required": ["observer"]}}}
      ]
    }
  }
}
