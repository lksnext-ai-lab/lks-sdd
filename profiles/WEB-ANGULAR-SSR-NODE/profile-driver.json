{
  "schema_version": "1.0",
  "profile_id": "WEB-ANGULAR-SSR-NODE",
  "profile_version": "1.0.0-candidate.1",
  "prepare": {
    "strategy": "copy",
    "sources": [
      {"from": "profiles/WEB-ANGULAR-SSR-NODE/scaffold", "to": "."},
      {"from": "profiles/WEB-ANGULAR-STATIC/scaffold/src/app", "to": "src/app"},
      {"from": "profiles/WEB-ANGULAR-STATIC/scaffold/src/styles.css", "to": "src/styles.css"},
      {"from": "profiles/WEB-ANGULAR-STATIC/scaffold/src/index.html", "to": "src/index.html"},
      {"from": "profiles/WEB-ANGULAR-STATIC/scaffold/e2e", "to": "e2e"}
    ]
  },
  "verify": {
    "checks": [
      {"id": "GATE-SCAFFOLD-INTEGRITY", "name": "scaffold-integrity", "phase": "G2", "kind": "command", "cwd": ".", "command": ["python", "-c", "from pathlib import Path; assert Path('server.ts').is_file(); assert Path('src/main.server.ts').is_file()"], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-FRONTEND-LOCK", "name": "frontend-lock", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "ci", "--ignore-scripts"], "required": true, "requires_containers": false, "timeout_seconds": 600},
      {"id": "GATE-FRONTEND-LINT", "name": "frontend-lint", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "lint"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-FRONTEND-TYPECHECK", "name": "frontend-typecheck", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "typecheck"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-FRONTEND-TEST", "name": "frontend-tests", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "test"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-SSR-BUILD", "name": "ssr-build", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npm", "run", "build"], "required": true, "requires_containers": false, "timeout_seconds": 600},
      {"id": "GATE-SSR-RUNTIME", "name": "ssr-runtime", "phase": "G3", "kind": "command", "cwd": ".", "command": ["python", "-c", "from pathlib import Path; assert any(Path('dist').rglob('server.mjs'))"], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-SSR-HYDRATION", "name": "ssr-hydration", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "local state"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-BROWSER-SMOKE", "name": "browser-smoke", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "smoke"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-BROWSER-ACCESSIBILITY", "name": "browser-accessibility", "phase": "G3", "kind": "command", "cwd": ".", "command": ["npx", "playwright", "test", "--grep", "accessibility"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-DELIVERY-EVIDENCE", "name": "delivery-evidence", "phase": "G4", "kind": "delivery-evidence", "cwd": ".", "command": [], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-COMPOSE-ANGULAR-SSR", "name": "profile-composition", "phase": "G3", "kind": "command", "cwd": ".", "command": ["python", "-c", "import json; a=json.load(open('angular.json', encoding='utf-8')); o=a['projects']['lks-sdd-angular-ssr']['architect']['build']['options']; assert o['server'] and o['ssr']"], "required": true, "requires_containers": false, "timeout_seconds": 30}
    ]
  }
}
