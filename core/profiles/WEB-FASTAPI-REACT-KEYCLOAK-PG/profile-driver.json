      {
        "id": "GATE-OIDC-INTEGRATION",
        "name": "oidc-integration",
        "phase": "G3",
        "kind": "command",
        "execution_context": "host",
        "cwd": ".",
        "command": [
          "python",
          "-c",
          "import time, urllib.request\nurl = 'http://127.0.0.1:18080/realms/lks-sdd/.well-known/openid-configuration'\nopener = urllib.request.build_opener(urllib.request.ProxyHandler({}))\nlast = None\nfor _ in range(30):\n    try:\n        if opener.open(url, timeout=5).status == 200:\n            raise SystemExit(0)\n    except Exception as exc:\n        last = exc\n    time.sleep(2)\nraise SystemExit(f'OIDC endpoint not ready: {last}')"
        ],
        "required": true,
        "requires_containers": true,
        "timeout_seconds": 90
      },
