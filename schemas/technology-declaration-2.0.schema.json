{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/technology-declaration-2.0.json",
  "title": "LKS-SDD local project technology declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "declarations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/declaration"
      }
    }
  },
  "$defs": {
    "local-path": {
      "type": "string",
      "pattern": "^(?:docs/lks-sdd/|[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*)"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "consumer-document",
            "consumer-lock",
            "static-observation"
          ]
        },
        "path": {
          "$ref": "#/$defs/local-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "historical-technology-source"
          ]
        },
        "path": {
          "$ref": "#/$defs/local-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "state",
        "critical",
        "scope",
        "evidence",
        "provenance"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "observed",
            "proposed",
            "confirmed",
            "unknown",
            "transition"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "const": "global"
              },
              {
                "type": "string",
                "pattern": "^TASK-[0-9]{3,}$"
              }
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "observed",
                  "proposed",
                  "confirmed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "transition"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value",
              "transition"
            ]
          }
        }
      ]
    },
    "declaration": {
      "type": "object",
      "required": [
        "id",
        "uid",
        "kind",
        "title",
        "revision",
        "state",
        "nature",
        "relations",
        "technology"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TECH-[0-9]{3,}$"
        },
        "uid": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "technology"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "observed",
            "proposed",
            "confirmed",
            "unknown",
            "transition"
          ]
        },
        "nature": {
          "enum": [
            "fact",
            "inference",
            "proposal",
            "decision",
            "unknown"
          ]
        },
        "relations": {
          "type": "object"
        },
        "technology": {
          "$ref": "#/$defs/technology"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "nature": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "transition"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "nature": {
                "const": "fact"
              }
            }
          }
        }
      ]
    }
  }
}
