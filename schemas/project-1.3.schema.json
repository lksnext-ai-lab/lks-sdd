{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/project-1.3.json",
  "title": "LKS-SDD 1.3 operational index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id", "route", "method_version", "schema_version", "plugin_version",
    "documentation_level", "risk_profile", "phase", "gate", "baseline_id",
    "canonical_docs", "artifacts", "technology", "active_increment", "active_plan",
    "active_task", "active_tasks", "delivery_governance", "version_control",
    "planning", "authorizations", "executions", "last_verified_revision"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3},
    "route": {"enum": ["new", "adopt-existing"]},
    "method_version": {"const": "1.3.0"},
    "schema_version": {"const": "1.3"},
    "plugin_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "documentation_level": {"enum": ["compact", "standard", "extended"]},
    "risk_profile": {"enum": ["P0", "P1", "P2", "undetermined"]},
    "phase": {"enum": ["discovery", "definition", "design", "planning", "readiness", "implementation", "verification", "operation", "adoption"]},
    "gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5"]},
    "baseline_id": {"type": "string", "pattern": "^BL-[0-9]{4}$"},
    "canonical_docs": {"const": "docs/lks-sdd"},
    "artifacts": {
      "type": "array", "minItems": 21,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^ART-[A-Z0-9-]+$"},
          "path": {"type": "string", "pattern": "^docs/lks-sdd/.+\\.md$"},
          "required": {"type": "boolean"}
        }
      }
    },
    "technology": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred_stack_assessed", "selected_profile", "selection_decision", "profile_bindings"],
      "properties": {
        "preferred_stack_assessed": {"type": "boolean"},
        "selected_profile": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9-]{2,95}$"},
        "selection_decision": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{3}$"},
        "profile_bindings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["binding_id", "unit_id", "unit_path", "profile_id", "profile_scope", "selection_decision", "lock_path", "state"],
            "properties": {
              "binding_id": {"type": "string", "pattern": "^BIND-[0-9]{3}$"},
              "unit_id": {"type": "string", "pattern": "^UNIT-[0-9]{3}$"},
              "unit_path": {"type": "string", "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"},
              "profile_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,95}$"},
              "profile_scope": {"enum": ["deployable", "system"]},
              "selection_decision": {"type": "string", "pattern": "^ADR-[0-9]{3}$"},
              "lock_path": {"type": "string", "pattern": "^\\.lks-sdd/profiles/BIND-[0-9]{3}\\.lock\\.json$"},
              "state": {"enum": ["proposed", "confirmed", "superseded", "retired"]}
            }
          }
        }
      }
    },
    "active_increment": {"type": ["string", "null"], "pattern": "^INC-[0-9]{3}$"},
    "active_plan": {"type": ["string", "null"], "pattern": "^PLAN-[0-9]{3}$"},
    "active_task": {"type": ["string", "null"], "pattern": "^TASK-[0-9]{3}$"},
    "active_tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
    "delivery_governance": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "model", "decision", "source", "active_change", "review_due"],
      "properties": {
        "state": {"enum": ["proposed", "confirmed", "superseded"]},
        "model": {"type": ["string", "null"], "enum": [null, "bounded-release", "continuous-evolution", "maintenance-stream"]},
        "decision": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{3}$"},
        "source": {"const": "docs/lks-sdd/04-delivery/delivery-governance.md"},
        "active_change": {"type": ["string", "null"], "pattern": "^CHG-[0-9]{3}$"},
        "review_due": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "version_control": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "origin", "branching_model", "main_branch", "integration_branch", "decision"],
      "properties": {
        "type": {"enum": ["git", "none"]},
        "origin": {"enum": ["github", "gitlab", "other", "none"]},
        "branching_model": {"type": ["string", "null"], "enum": [null, "trunk-based", "github-flow", "gitlab-flow", "release-branches", "custom", "not-applicable"]},
        "main_branch": {"type": ["string", "null"], "minLength": 1},
        "integration_branch": {"type": ["string", "null"], "minLength": 1},
        "decision": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{3}$"}
      }
    },
    "planning": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target_type", "target_id", "policy", "policy_decision", "specification_fingerprint", "planning_fingerprint", "confirmed_by_role", "confirmed_on", "last_change"],
      "properties": {
        "source": {"const": "docs/lks-sdd/04-delivery/planning-coverage.md"},
        "target_type": {"type": ["string", "null"], "enum": [null, "increment", "release"]},
        "target_id": {"type": ["string", "null"], "pattern": "^(?:INC|REL)-[0-9]{3}$"},
        "policy": {"enum": ["complete-before-implementation", "incremental-authorized"]},
        "policy_decision": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{3}$"},
        "specification_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "planning_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "confirmed_by_role": {"type": ["string", "null"], "minLength": 1},
        "confirmed_on": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "last_change": {"type": ["string", "null"], "pattern": "^PCH-[0-9]{3}$"}
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["authorization_id", "state", "target", "increment", "release", "task_ids", "specification_fingerprint", "planning_fingerprint", "authorized_by_role", "authorized_on", "decision", "constraints"],
        "properties": {
          "authorization_id": {"type": "string", "pattern": "^AUTH-[0-9]{3}$"},
          "state": {"enum": ["authorized", "invalidated", "revoked"]},
          "target": {"type": "string", "pattern": "^(?:INC|REL)-[0-9]{3}$"},
          "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
          "release": {"type": "string", "pattern": "^REL-[0-9]{3}$"},
          "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
          "specification_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "planning_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "authorized_by_role": {"type": "string", "minLength": 1},
          "authorized_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "decision": {"type": "string", "pattern": "^ADR-[0-9]{3}$"},
          "constraints": {"type": "string", "minLength": 1}
        }
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["execution_id", "status", "increment", "release", "task_ids", "profile_bindings", "locks", "branch", "revision_start", "last_observed_revision", "authorization_id", "specification_fingerprint", "planning_fingerprint", "latest_checkpoint", "changed_paths", "evidence_ids"],
        "properties": {
          "execution_id": {"type": "string", "pattern": "^EXEC-[0-9]{3}$"},
          "status": {"enum": ["in-progress", "in-review", "paused", "blocked", "completed", "cancelled"]},
          "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
          "release": {"type": "string", "pattern": "^REL-[0-9]{3}$"},
          "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
          "profile_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BIND-[0-9]{3}$"}},
          "locks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["binding_id", "sha256"],
              "properties": {
                "binding_id": {"type": "string", "pattern": "^BIND-[0-9]{3}$"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          "branch": {"type": ["string", "null"], "minLength": 1},
          "revision_start": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
          "last_observed_revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
          "authorization_id": {"type": "string", "pattern": "^AUTH-[0-9]{3}$"},
          "specification_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "planning_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "latest_checkpoint": {"type": ["string", "null"], "pattern": "^docs/lks-sdd/04-delivery/checkpoints/CKPT-[0-9]{3}\\.md$"},
          "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[0-9]{3}$"}}
        }
      }
    },
    "last_verified_revision": {"type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
    "adoption": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "strategy", "baseline_freshness", "report_sha256", "decision_sha256", "inventory_fingerprint", "expected_revision", "materialized_at", "write_scope"],
      "properties": {
        "status": {"enum": ["inventory_pending", "inventory_complete", "business_validation_pending", "reconciliation_pending", "confirmation_pending", "materialization_pending", "materialized"]},
        "strategy": {"type": ["string", "null"], "enum": [null, "documentation", "progressive-normalization", "planned-modernization"]},
        "baseline_freshness": {"enum": ["current", "stale", "unknown"]},
        "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "inventory_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_revision": {"type": ["string", "null"]},
        "materialized_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "write_scope": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"type": "string", "enum": [".lks-sdd/", "docs/lks-sdd/"]}
        }
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "increment", "task_ids", "profile_bindings", "branch", "revision_start", "locks", "changed_paths", "evidence_ids"],
      "properties": {
        "status": {"enum": ["not-started", "in-progress", "completed", "blocked"]},
        "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
        "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
        "profile_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BIND-[0-9]{3}$"}},
        "branch": {"type": ["string", "null"], "minLength": 1},
        "revision_start": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
        "locks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["binding_id", "sha256"],
            "properties": {
              "binding_id": {"type": "string", "pattern": "^BIND-[0-9]{3}$"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[0-9]{3}$"}},
        "authorization_id": {"type": "string", "pattern": "^AUTH-[0-9]{3}$"},
        "specification_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "planning_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "latest_checkpoint": {"type": "string", "pattern": "^docs/lks-sdd/04-delivery/checkpoints/CKPT-[0-9]{3}\\.md$"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "increment", "task_ids", "revision", "tree_id", "tree_sha256", "build_id", "artifact_digests", "environment", "gate_ids", "evidence_ids", "limitations"],
      "properties": {
        "status": {"enum": ["not-run", "verified", "verified-with-reservations", "not-verified"]},
        "execution_id": {"type": "string", "pattern": "^EXEC-[0-9]{3}$"},
        "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
        "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
        "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
        "tree_id": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace:[a-f0-9]{64})$"},
        "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "build_id": {"type": "string", "pattern": "^build-sha256:[a-f0-9]{64}$"},
        "artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
        "environment": {"type": "string", "pattern": "^(?:ENV-[0-9]{3}|not-applicable)$"},
        "gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GATE-[A-Z0-9-]{3,80}$"}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[0-9]{3}$"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "last_delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["release", "environment", "revision", "tree_id", "build_id", "artifact_digests", "status", "evidence_ids"],
      "properties": {
        "release": {"type": "string", "pattern": "^REL-[0-9]{3}$"},
        "environment": {"type": "string", "pattern": "^ENV-[0-9]{3}$"},
        "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
        "tree_id": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace:[a-f0-9]{64})$"},
        "build_id": {"type": "string", "pattern": "^build-sha256:[a-f0-9]{64}$"},
        "artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
        "status": {"enum": ["promoted", "deployed", "verified", "rolled-back", "failed"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVID-[0-9]{3}$"}}
      }
    }
  }
}
