{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/delivery-evidence-1.0.json",
  "title": "LKS-SDD G4 delivery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release", "environment", "revision", "tree_id",
    "build_id", "artifact_digests", "promotion", "smoke",
    "observability", "recovery", "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release": {"type": "string", "pattern": "^REL-[0-9]{3}$"},
    "environment": {"type": "string", "pattern": "^ENV-[0-9]{3}$"},
    "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace-sha256:[a-f0-9]{64})$"},
    "tree_id": {"type": "string", "pattern": "^(?:[a-f0-9]{40,64}|workspace:[a-f0-9]{64})$"},
    "build_id": {"type": "string", "pattern": "^build-sha256:[a-f0-9]{64}$"},
    "artifact_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "promotion": {"$ref": "#/$defs/checkEvidence"},
    "smoke": {"$ref": "#/$defs/checkEvidence"},
    "observability": {"$ref": "#/$defs/checkEvidence"},
    "recovery": {"$ref": "#/$defs/checkEvidence"},
    "authorization": {"$ref": "#/$defs/authorizationEvidence"}
  },
  "$defs": {
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recorded_at", "reference"],
      "properties": {
        "status": {"const": "passed"},
        "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "authorizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recorded_at", "reference", "authority"],
      "properties": {
        "status": {"const": "passed"},
        "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "authority": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
