{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/technology-profile-lock-1.0.json",
  "title": "LKS-SDD exact technology profile lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_version", "generated_at", "validated", "components", "evidence"],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "profile_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "validated": {"type": "boolean"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
