{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/quality-observations-1.0.json",
  "title": "LKS-SDD sanitized quality observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "corpus_sha256", "evaluator_context", "activation_results", "document_reviews"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "minLength": 3},
    "corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "product", "executed_on", "evidence_reference"],
      "properties": {
        "kind": {"enum": ["controlled-codex-session", "human-review"]},
        "product": {"const": "Codex"},
        "executed_on": {"type": "string", "format": "date"},
        "evidence_reference": {"type": "string", "minLength": 3}
      }
    },
    "activation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "actual_skill"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^ACT-[0-9]{3}$"},
          "actual_skill": {"type": ["string", "null"]}
        }
      }
    },
    "document_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_reference", "scores"],
        "properties": {
          "artifact_reference": {"type": "string", "minLength": 3},
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 10,
            "maxProperties": 10,
            "properties": {
              "correctness": {"type": "integer", "minimum": 1, "maximum": 5},
              "completeness": {"type": "integer", "minimum": 1, "maximum": 5},
              "clarity": {"type": "integer", "minimum": 1, "maximum": 5},
              "verifiability": {"type": "integer", "minimum": 1, "maximum": 5},
              "traceability": {"type": "integer", "minimum": 1, "maximum": 5},
              "proportionality": {"type": "integer", "minimum": 1, "maximum": 5},
              "operational_utility": {"type": "integer", "minimum": 1, "maximum": 5},
              "audience_fit": {"type": "integer", "minimum": 1, "maximum": 5},
              "information_separation": {"type": "integer", "minimum": 1, "maximum": 5},
              "information_protection": {"type": "integer", "minimum": 1, "maximum": 5}
            },
            "required": ["correctness", "completeness", "clarity", "verifiability", "traceability", "proportionality", "operational_utility", "audience_fit", "information_separation", "information_protection"]
          }
        }
      }
    }
  }
}
