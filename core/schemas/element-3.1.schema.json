{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "uid",
    "id",
    "kind",
    "revision",
    "title",
    "state",
    "nature",
    "relations",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "uid": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string"
    },
    "nature": {
      "enum": [
        "fact",
        "inference",
        "proposal",
        "decision",
        "unknown"
      ]
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "data": {
      "type": "object"
    },
    "progress": {
      "type": "object"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
