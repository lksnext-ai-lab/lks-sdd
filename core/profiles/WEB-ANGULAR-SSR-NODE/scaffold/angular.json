{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "lks-sdd-angular-ssr": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": {"entry": "server.ts"},
            "outputMode": "server",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"],
            "outputPath": "dist/lks-sdd-angular-ssr"
          },
          "configurations": {
            "production": {"outputHashing": "all", "sourceMap": false}
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
