{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/technology-profile-lock-2.0.json",
  "title": "LKS-SDD exact profile composition lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "generated_at",
    "profile_sha256",
    "driver_sha256",
    "scaffold_sha256",
    "capabilities",
    "components",
    "gates",
    "composition",
    "structural"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,95}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "driver_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scaffold_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9-]{3,80}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GATE-[A-Z0-9-]{3,80}$"
          },
          "phase": {
            "enum": [
              "G2",
              "G3",
              "G4"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "digest"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^GATE-[A-Z0-9-]{3,80}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "structural": {
      "type": "boolean"
    }
  }
}
