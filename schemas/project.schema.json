{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/project-1.0.json",
  "title": "LKS-SDD project operational index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "route",
    "method_version",
    "schema_version",
    "plugin_version",
    "documentation_level",
    "risk_profile",
    "phase",
    "gate",
    "baseline_id",
    "canonical_docs",
    "artifacts",
    "technology",
    "active_increment",
    "open_blockers",
    "readiness",
    "version_control",
    "last_verified_revision"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "route": {
      "enum": ["new", "adopt-existing"]
    },
    "method_version": {
      "const": "1.0.0"
    },
    "schema_version": {
      "const": "1.0"
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "documentation_level": {
      "enum": ["compact", "standard", "extended"]
    },
    "risk_profile": {
      "enum": ["P0", "P1", "P2", "undetermined"]
    },
    "phase": {
      "enum": ["discovery", "definition", "design", "planning", "readiness", "implementation", "verification", "operation", "adoption"]
    },
    "gate": {
      "enum": ["G0", "G1", "G2", "G3", "G4", "G5"]
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^BL-[0-9]{4}$"
    },
    "canonical_docs": {
      "const": "docs/lks-sdd"
    },
    "artifacts": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^ART-[A-Z0-9-]+$"},
          "path": {"type": "string", "pattern": "^docs/lks-sdd/.+\\.md$"},
          "required": {"type": "boolean"}
        }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_stack_assessed", "selected_profile", "selection_decision"],
      "properties": {
        "preferred_stack_assessed": {"type": "boolean"},
        "selected_profile": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
        },
        "selection_decision": {
          "type": ["string", "null"],
          "pattern": "^ADR-[0-9]{3}$"
        }
      }
    },
    "active_increment": {
      "type": ["string", "null"],
      "pattern": "^INC-[0-9]{3}$"
    },
    "open_blockers": {
      "type": "array",
      "items": {"type": "string", "pattern": "^OPEN-[0-9]{3}$"}
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assessed_increment", "assessed_at"],
      "properties": {
        "status": {"enum": ["not-assessed", "ready", "ready-with-non-blocking-pending", "blocked"]},
        "assessed_increment": {"type": ["string", "null"], "pattern": "^INC-[0-9]{3}$"},
        "assessed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "version_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "origin"],
      "properties": {
        "type": {"enum": ["git", "none"]},
        "origin": {"enum": ["github", "gitlab", "other", "none"]}
      }
    },
    "last_verified_revision": {
      "type": ["string", "null"]
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "strategy", "baseline_freshness"],
      "properties": {
        "status": {"enum": ["inventory_pending", "inventory_complete", "business_validation_pending", "reconciliation_pending", "confirmation_pending", "materialization_pending", "materialized"]},
        "strategy": {"type": ["string", "null"], "enum": [null, "documentation", "progressive-normalization", "planned-modernization"]},
        "baseline_freshness": {"enum": ["current", "stale", "unknown"]}
      }
    }
  }
}
