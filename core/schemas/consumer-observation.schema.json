{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer observer output 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "gate_id", "run_nonce", "status", "scopes", "interfaces", "observations", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate_id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]{3,80}$"},
    "run_nonce": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["component", "contract", "composition", "user-flow", "persistence", "visual"]}},
    "interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^INT-[0-9]{3}$"}},
    "observations": {"type": "object", "minProperties": 1},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }}
  }
}
