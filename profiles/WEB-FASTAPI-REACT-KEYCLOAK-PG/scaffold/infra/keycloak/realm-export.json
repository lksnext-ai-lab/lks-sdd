{
  "realm": "lks-sdd",
  "enabled": true,
  "displayName": "LKS-SDD development realm",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "lks-sdd-api",
      "name": "LKS-SDD reference API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "lks-sdd-spa",
      "name": "LKS-SDD reference SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:15173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:15173"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {
          "name": "lks-sdd-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lks-sdd-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "lks-sdd-gate-user",
      "email": "gate-user@example.invalid",
      "firstName": "LKS-SDD",
      "lastName": "Gate User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "lks-sdd-gate-password", "temporary": false}
      ]
    }
  ]
}
