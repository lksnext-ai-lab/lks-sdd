{
  "schema_version": "1.0",
  "profile_id": "API-FASTAPI-SIMULATED-OIDC-PG-OCI",
  "profile_version": "1.0.0",
  "prepare": {"strategy": "copy", "sources": [{"from": "profiles/API-FASTAPI-SIMULATED-OIDC-PG-OCI/scaffold", "to": "."}]},
  "verify": {
    "checks": [
      {"id": "GATE-SCAFFOLD-INTEGRITY", "name": "scaffold-integrity", "phase": "G2", "kind": "command", "cwd": ".", "command": ["python", "-c", "from pathlib import Path; assert Path('pyproject.toml').is_file(); assert Path('infra/compose.yaml').is_file(); text=Path('src/lks_sdd_app/security.py').read_text(encoding='utf-8'); config=Path('src/lks_sdd_app/config.py').read_text(encoding='utf-8'); assert 'disabled outside explicit non-production environments' in text; assert 'canonical_simulated_oidc_issuer' in config; assert 'PRIVATE_KEY = rsa.generate_private_key' in text"], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-API-LOCK", "name": "api-lock", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "sync", "--frozen"], "required": true, "requires_containers": false, "timeout_seconds": 600},
      {"id": "GATE-API-LINT", "name": "api-lint", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "ruff", "check", "."], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-API-TYPECHECK", "name": "api-typecheck", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "mypy"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-API-TEST", "name": "api-tests", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest"], "required": true, "requires_containers": false, "timeout_seconds": 300},
      {"id": "GATE-API-OPENAPI", "name": "api-openapi", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "python", "-c", "import sys; sys.path.insert(0, 'src'); from lks_sdd_app.main import app; assert app.openapi()['openapi'].startswith('3.1.')"], "required": true, "requires_containers": false, "timeout_seconds": 60},
      {"id": "GATE-OIDC-CONTRACT", "name": "oidc-contract", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "oidc_contract"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-OIDC-DISCOVERY", "name": "oidc-discovery", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "oidc_discovery"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-OIDC-JWKS", "name": "oidc-jwks", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "jwks"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-OIDC-API-AUTHN", "name": "oidc-api-authentication", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "api_authentication"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-OIDC-API-AUTHZ", "name": "oidc-api-authorization", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "api_authorization"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-OIDC-SIMULATED-SAFETY", "name": "simulated-identity-safety", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "pytest", "-k", "simulated_identity_safety"], "required": true, "requires_containers": false, "timeout_seconds": 180},
      {"id": "GATE-DATA-MIGRATION", "name": "migration-contract", "phase": "G3", "kind": "command", "cwd": ".", "command": ["uv", "run", "alembic", "upgrade", "head", "--sql"], "required": true, "requires_containers": false, "timeout_seconds": 120},
      {"id": "GATE-OCI-BUILD", "name": "oci-build", "phase": "G3", "kind": "command", "cwd": ".", "command": ["docker", "compose", "-f", "infra/compose.yaml", "build"], "required": true, "requires_containers": true, "timeout_seconds": 1200},
      {"id": "GATE-OCI-SMOKE", "name": "oci-smoke", "phase": "G3", "kind": "command", "cwd": ".", "command": ["docker", "compose", "-f", "infra/compose.yaml", "up", "-d", "--wait"], "required": true, "requires_containers": true, "timeout_seconds": 600},
      {"id": "GATE-OIDC-SIMULATED-INTEGRATION", "name": "simulated-oidc-integration", "phase": "G3", "kind": "command", "execution_context": "host", "cwd": ".", "command": ["python", "scripts/verify_simulated_oidc.py"], "required": true, "requires_containers": true, "timeout_seconds": 120},
      {"id": "GATE-DATA-INTEGRATION", "name": "data-integration", "phase": "G3", "kind": "command", "cwd": ".", "command": ["docker", "compose", "-f", "infra/compose.yaml", "exec", "-T", "postgres", "pg_isready", "-U", "lks_sdd", "-d", "app"], "required": true, "requires_containers": true, "timeout_seconds": 60},
      {"id": "GATE-DELIVERY-EVIDENCE", "name": "delivery-evidence", "phase": "G4", "kind": "delivery-evidence", "cwd": ".", "command": [], "required": true, "requires_containers": false, "timeout_seconds": 30},
      {"id": "GATE-COMPOSE-FASTAPI-SIMULATED-OIDC-PG", "name": "profile-composition", "phase": "G3", "kind": "command", "execution_context": "host", "cwd": ".", "command": ["python", "-c", "import json,urllib.request; assert urllib.request.urlopen('http://127.0.0.1:18000/health', timeout=15).status == 200; d=json.load(urllib.request.urlopen('http://127.0.0.1:18000/__test__/oidc/.well-known/openid-configuration', timeout=15)); assert d['code_challenge_methods_supported']==['S256']"], "required": true, "requires_containers": true, "timeout_seconds": 60}
    ]
  }
}
