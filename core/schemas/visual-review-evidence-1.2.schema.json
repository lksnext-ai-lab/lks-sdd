{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lks.invalid/lks-sdd/schemas/visual-review-evidence-1.2.json",
  "title": "LKS-SDD TASK-scoped visual review evidence 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "increment", "status", "review_type", "reviewed_at", "reviewer", "revision", "task_reviews", "screenshots", "limitations"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "increment": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
    "status": {"enum": ["passed", "failed", "not-verified"]},
    "review_type": {"enum": ["manual-browser", "automated-browser"]},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "revision": {"$ref": "#/$defs/revision"},
    "task_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status", "acceptance_ids", "ux_ids", "vis_ids", "screenshots", "not_applicable_reason"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
          "status": {"enum": ["passed", "failed", "not-verified", "not-applicable"]},
          "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
          "ux_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UX-[0-9]{3}$"}},
          "vis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VIS-[0-9]{3}$"}},
          "screenshots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SHOT-[0-9]{3}$"}},
          "not_applicable_reason": {"type": ["string", "null"]}
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task_ids", "acceptance_ids", "ux_ids", "vis_ids", "path", "sha256", "surface", "route", "prior_state", "interaction", "expected", "observed", "expectation_match", "theme", "viewport", "dimensions", "browser", "revision", "reviewed_at", "reviewer", "result", "limitations", "legibility", "duplicate_justification", "supersedes"],
        "properties": {
          "id": {"type": "string", "pattern": "^SHOT-[0-9]{3}$"},
          "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{3}$"}},
          "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
          "ux_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UX-[0-9]{3}$"}},
          "vis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VIS-[0-9]{3}$"}},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "surface": {"type": "string", "minLength": 1},
          "route": {"type": "string", "pattern": "^/.*$"},
          "prior_state": {"type": "string", "minLength": 1},
          "interaction": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "expectation_match": {"type": "boolean"},
          "theme": {"type": "string", "minLength": 1},
          "viewport": {
            "type": "object", "additionalProperties": false,
            "required": ["width", "height", "dpr", "capture"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "dpr": {"type": "number", "exclusiveMinimum": 0},
              "capture": {"enum": ["viewport", "full-page"]}
            }
          },
          "dimensions": {
            "type": "object", "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
          },
          "browser": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
          },
          "revision": {"$ref": "#/$defs/revision"},
          "reviewed_at": {"type": "string", "minLength": 1},
          "reviewer": {"$ref": "#/$defs/reviewer"},
          "result": {"enum": ["passed", "failed", "not-verified"]},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "legibility": {"enum": ["readable", "illegible"]},
          "duplicate_justification": {"type": ["string", "null"]},
          "supersedes": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["evidence", "screenshot_id", "sha256"],
                "properties": {
                  "evidence": {"type": "string", "pattern": "^docs/lks-sdd/evidence/visual/.+\\.json$"},
                  "screenshot_id": {"type": "string", "pattern": "^SHOT-[0-9]{3}$"},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            ]
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "alias"],
      "properties": {"role": {"type": "string", "minLength": 1}, "alias": {"type": "string", "minLength": 1}}
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "tree_id", "tree_sha256"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "tree_id": {"type": "string", "minLength": 1},
        "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
